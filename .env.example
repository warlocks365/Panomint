# ---- PostgreSQL ----
POSTGRES_USER=pano
POSTGRES_PASSWORD=change-me-in-prod
POSTGRES_DB=pano_album
POSTGRES_PORT=5432

# ---- Valkey (Redis 兼容, BSD-3-Clause) ----
VALKEY_PORT=6379

# ---- MinIO (S3 兼容对象存储) ----
MINIO_ROOT_USER=pano
MINIO_ROOT_PASSWORD=change-me-in-prod
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# =====================================================================
# 后端配置（键名以 internal/config 与各 worker 实际读取的为准）
#
# ⚠️ 用法：把本文件复制为 `.env` 再改。`.env` 已在 .gitignore 里，不会入库。
#
# 为什么要单独列这些：本项目定位是**通用相册系统** —— 需支持任意平台的容器化部署，
# 或独立服务器安装。因此所有"环境相关"的开关都必须在这里**可见、可覆盖**，
# 而不是藏在代码默认值里（历史事故：PG_DSN 的默认值曾指向某台内网机器并内嵌明文口令，
# 谁忘设环境变量谁就连到别人的库）。
# =====================================================================

# ---- 运行时环境 ----
# dev|prod。⚠️ 设为 prod 时，若 PG_DSN / VALKEY_ADDR / MEDIA_ROOT 仍是"仅供本机开发"的
# 默认值，进程会**启动即失败**（宁可起不来，也不要静默连到 127.0.0.1 上的陌生库）。
#APP_ENV=dev

# ---- 依赖服务地址（容器内由 compose 注入；裸机/独立部署时才需要在这里给）----
#PG_DSN=postgres://<user>:<password>@127.0.0.1:5432/pano_album
#VALKEY_ADDR=127.0.0.1:6379
#VALKEY_PASSWORD=

# ---- 密钥（⚠️ 生产必须改）----
#JWT_SECRET=
# 初始化管理员口令（仅首次建号用）
#ADMIN_PASSWORD=

# ---- 监听与跨域 ----
#API_PORT=8080
# 允许的跨域源，逗号分隔。留空 = **不放行任何跨域源**。
# 通用部署通常不需要它：前端由同一个 web server 同源托管并反向代理 API，同源请求不触发 CORS。
#CORS_ORIGINS=

# ---- 媒体与派生文件目录（容器内由 compose 覆盖为 /data/*）----
#UPLOAD_DIR=./data/media
#UPLOAD_TMP=./data/uploads
#HLS_DIR=./data/hls
#MEDIA_ROOT=./data/media
#THUMB_DIR=./data/thumbnails
# 瓦片磁盘缓存目录；留空 = 不缓存（高频拖动地图易触发高德 429 限流）
#TILE_CACHE_DIR=

# ---- ffmpeg（留空 = 从 PATH 查找）----
#FFMPEG_PATH=
#FFPROBE_PATH=

# ---- 语义检索推理（双接口原则：GPU 与 CPU 两条路径都必须可用）----
# cpu|cuda|auto；auto = 优先 CUDA、不可用则回落 CPU。**无 GPU 的机器请用 cpu 或留 auto**
#EMBED_DEVICE=auto
#EMBED_DEVICE_ID=0
#EMBED_THREADS=0
# 模型族：chinese-clip（默认，中文检索）| clip（OpenAI CLIP）
# ⚠️ 两族向量空间不同，切换后必须重跑 embedgen -mode encode -force 全量重算
#EMBED_FAMILY=chinese-clip
#EMBED_MODEL_DIR=
# ONNX Runtime 动态库路径（默认随镜像提供）
#EMBED_LIB=
# 留空 = 用内置默认值
#EMBED_GPU_MEM_MB=
#EMBED_SEMANTIC_MAX_DIST=

# ---- 人脸推理（同为双接口原则）----
#FACE_DEVICE=auto
#FACE_DEVICE_ID=0
#FACE_THREADS=
#FACE_LIB=
#FACE_MODEL_DIR=
# 以下阈值留空 = 用内置默认值（当前取值见代码与项目记录）
#FACE_CONF=
#FACE_MIN_PX=
#FACE_MERGE_SIM=
#FACE_NMS=
#FACE_INPUT_SIZE=
#FACE_INPUT_MAX=

# ---- AI 打标 ----
#TAG_MIN_SIM=
#TAG_MAX_PER_MEDIA=
#TAG_MIN_TOP1=
#TAG_TOP_RATIO=

# ---- 地图服务（高德；留空 = 相关功能降级，不报错）----
#AMAP_KEY=
#AMAP_SECRET=

# ---- 算力节点（存储与算力分离；默认只认领 noop）----
#COMPUTE_CLAIMABLE_KINDS=noop
#COMPUTE_MAX_ATTEMPTS=
#COMPUTE_OFFLINE_AFTER_SECONDS=

# ---- 其它 ----
#WATCH_STATE=
#BW_PROBE_BYTES=
#BW_PROBE_MAX_MS=
