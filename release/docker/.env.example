# Panomint Docker 形态环境样例（v1.0.0）
# 复制为 .env 后填写；标 [必填] 的不填 compose 会拒绝启动（fail-fast）

PANOMINT_VERSION=1.0.0

# [必填] 数据库口令（仅本机部署可用默认值，公网部署必须改）
POSTGRES_USER=pano
POSTGRES_PASSWORD=
POSTGRES_DB=pano_album

# [必填] JWT 签名密钥：openssl rand -hex 32
JWT_SECRET=

# Web 端口（默认 8088）
WEB_PORT=8088

# ---- 可选 ----
# 前后端分离调试才需要；默认同源部署留空
# CORS_ORIGINS=
# 高德地图（空=搜索降级）：Web 服务类型 Key
# AMAP_KEY=
# AMAP_SECRET=
# 挂载凭据加密密钥（32 字节 hex；用网络挂载才需要）：openssl rand -hex 32
# STORAGE_CIPHER_KEY=
# AI 设备：cpu|cuda|auto
# EMBED_DEVICE=auto
# FACE_DEVICE=
# 模型族：chinese-clip（默认）| clip（切换须全量重算向量）
# EMBED_FAMILY=chinese-clip

# ---- profile=edge（Caddy 入口）时必填 ----
# SITE_ADDRESS=album.example.com
